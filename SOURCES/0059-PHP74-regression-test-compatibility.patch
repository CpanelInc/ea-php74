diff --git a/ext/standard/tests/wrapper-security.inc b/ext/standard/tests/wrapper-security.inc
--- /dev/null
+++ b/ext/standard/tests/wrapper-security.inc
@@ -0,0 +1,32 @@
+<?php
+function check_wrapper_transport($scheme) {
+    $server = <<<'PHP'
+$server = stream_socket_server('tcp://127.0.0.1:0');
+echo stream_socket_get_name($server, false), "\n";
+flush();
+$connection = stream_socket_accept($server, 5);
+stream_set_timeout($connection, 3);
+if ($argv[1] === 'ftp') {
+    fwrite($connection, "220 Ready\r\n");
+    echo stream_get_line($connection, 8192, "\r\n"), "\n";
+} else {
+    echo fread($connection, 1) === "\x16" ? "TLS\n" : "plaintext\n";
+}
+fclose($connection);
+fclose($server);
+PHP;
+    $process = proc_open([PHP_BINARY, '-n', '-r', $server, stripos($scheme, 'ftp') === 0 ? 'ftp' : 'http'],
+        [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
+    $address = trim(fgets($pipes[1]));
+    $context = stream_context_create(['http' => ['timeout' => 2],
+        'ssl' => ['verify_peer' => false, 'verify_peer_name' => false]]);
+    $stream = @fopen($scheme . '://' . $address . '/test', 'r', false, $context);
+    if (is_resource($stream)) {
+        fclose($stream);
+    }
+    echo $scheme, ': ', stream_get_contents($pipes[1]);
+    foreach ($pipes as $pipe) {
+        fclose($pipe);
+    }
+    proc_close($process);
+}
diff --git a/ext/standard/tests/wrapper-security-php74.phpt b/ext/standard/tests/wrapper-security-php74.phpt
--- /dev/null
+++ b/ext/standard/tests/wrapper-security-php74.phpt
@@ -0,0 +1,18 @@
+--TEST--
+HTTPS and FTPS select TLS independently of URL scheme case
+--EXTENSIONS--
+openssl
+--SKIPIF--
+<?php if (!function_exists('proc_open')) die('skip proc_open unavailable'); ?>
+--FILE--
+<?php
+require __DIR__ . '/wrapper-security.inc';
+foreach (['https', 'HTTPS', 'ftps', 'FTPS'] as $scheme) {
+    check_wrapper_transport($scheme);
+}
+?>
+--EXPECT--
+https: TLS
+HTTPS: TLS
+ftps: AUTH TLS
+FTPS: AUTH TLS
